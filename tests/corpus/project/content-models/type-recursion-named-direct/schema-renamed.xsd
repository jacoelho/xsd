<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="ZBase">
    <xs:sequence>
      <xs:element name="basePart" type="xs:string" />
      <xs:element name="child" type="ALeaf" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="baseRequired" type="xs:int" use="required" />
  </xs:complexType>
  <xs:complexType name="ALeaf">
    <xs:complexContent>
      <xs:extension base="ZBase">
        <xs:sequence>
          <xs:element name="leafPart" type="xs:string" />
        </xs:sequence>
        <xs:attribute name="leafRequired" type="xs:int" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="root" type="ZBase" />
</xs:schema>
