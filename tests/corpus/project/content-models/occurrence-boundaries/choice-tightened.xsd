<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:group name="Alternatives"><xs:choice><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice></xs:group>
  <xs:complexType name="Base"><xs:choice minOccurs="1" maxOccurs="1"><xs:choice minOccurs="2" maxOccurs="3"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice><xs:element name="c" type="xs:string"/></xs:choice></xs:complexType>
  <xs:complexType name="Derived"><xs:complexContent><xs:restriction base="Base"><xs:choice minOccurs="1" maxOccurs="1"><xs:choice minOccurs="2" maxOccurs="2"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice><xs:element name="c" type="xs:string"/></xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="Grouped"><xs:complexContent><xs:restriction base="Base"><xs:choice minOccurs="1" maxOccurs="1"><xs:group ref="Alternatives" minOccurs="2" maxOccurs="2"/><xs:element name="c" type="xs:string"/></xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="OptionalBase"><xs:choice minOccurs="1" maxOccurs="1"><xs:choice minOccurs="0" maxOccurs="3"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice><xs:element name="c" type="xs:string"/></xs:choice></xs:complexType>
  <xs:complexType name="OptionalDerived"><xs:complexContent><xs:restriction base="OptionalBase"><xs:choice minOccurs="1" maxOccurs="1"><xs:choice minOccurs="0" maxOccurs="2"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice><xs:element name="c" type="xs:string"/></xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="RootBase"><xs:choice minOccurs="2" maxOccurs="3"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice></xs:complexType>
  <xs:complexType name="RootInline"><xs:complexContent><xs:restriction base="RootBase"><xs:choice minOccurs="2" maxOccurs="2"><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:string"/></xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:element name="base" type="Base"/>
  <xs:element name="derived" type="Derived"/>
  <xs:element name="grouped" type="Grouped"/>
  <xs:element name="optionalBase" type="OptionalBase"/>
  <xs:element name="optional" type="OptionalDerived"/>
  <xs:element name="rootBase" type="RootBase"/>
  <xs:element name="inline" type="RootInline"/>
</xs:schema>
