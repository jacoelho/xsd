<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="root">
    <xs:complexType><xs:sequence>
      <xs:sequence minOccurs="0" maxOccurs="0">
        <xs:element name="omitted" type="xs:string">
          <xs:key name="SharedKey"><xs:selector xpath="." /><xs:field xpath="." /></xs:key>
        </xs:element>
      </xs:sequence>
      <xs:element name="item" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="id" type="xs:int" use="required" /></xs:complexType></xs:element>
    </xs:sequence></xs:complexType>
    <xs:keyref name="LiveReference" refer="SharedKey"><xs:selector xpath="item" /><xs:field xpath="@id" /></xs:keyref>
  </xs:element>
</xs:schema>
