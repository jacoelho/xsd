<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="ABase" mixed="true">
    <xs:sequence>
      <xs:element name="child" minOccurs="0">
        <xs:complexType>
          <xs:simpleContent>
            <xs:restriction base="BMiddle">
              <xs:simpleType><xs:restriction base="xs:string" /></xs:simpleType>
              <xs:attribute name="baseRequired" type="xs:int" use="required" />
              <xs:attribute name="middleRequired" type="xs:int" use="required" />
            </xs:restriction>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="baseRequired" type="xs:int" use="required" />
  </xs:complexType>
  <xs:complexType name="BMiddle">
    <xs:complexContent mixed="true">
      <xs:extension base="ABase">
        <xs:attribute name="middleRequired" type="xs:int" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="root" type="ABase" />
</xs:schema>
