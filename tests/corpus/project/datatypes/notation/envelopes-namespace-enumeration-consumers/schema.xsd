<xs:element name="list"><xs:complexType><xs:attribute name="kind" type="r:ListA" use="required"/></xs:complexType></xs:element>
<xs:element name="union"><xs:complexType><xs:attribute name="kind" type="r:UnionA" use="required"/></xs:complexType></xs:element>
<xs:element name="wrap"><xs:complexType><xs:sequence><xs:element ref="r:only"/></xs:sequence></xs:complexType></xs:element>
</xs:schema>
