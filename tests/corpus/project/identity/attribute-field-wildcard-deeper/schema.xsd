<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="s" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="a">
                <xs:complexType><xs:attribute name="k" type="xs:string"/></xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="u"><xs:selector xpath="s"/><xs:field xpath="a/@*"/></xs:unique>
  </xs:element>
</xs:schema>
