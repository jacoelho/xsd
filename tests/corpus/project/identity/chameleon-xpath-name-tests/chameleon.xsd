<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="list">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="item" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:string"/>
            <xs:attribute name="key" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="byUnprefixedName">
      <xs:selector xpath="item"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <xs:unique name="byWildcard">
      <xs:selector xpath="*"/>
      <xs:field xpath="@key"/>
    </xs:unique>
  </xs:element>
</xs:schema>
