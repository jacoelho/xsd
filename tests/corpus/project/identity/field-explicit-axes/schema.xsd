<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="S">
    <xs:sequence>
      <xs:element name="e" minOccurs="0">
        <xs:complexType><xs:attribute name="x" type="xs:string"/></xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="x" type="xs:string"/>
  </xs:complexType>
  <xs:element name="win">
    <xs:complexType><xs:sequence><xs:element name="s" type="S" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
    <xs:unique name="axisAttr"><xs:selector xpath="s"/><xs:field xpath="attribute::x"/></xs:unique>
    <xs:unique name="childAttr"><xs:selector xpath="s"/><xs:field xpath="child::e/@x"/></xs:unique>
  </xs:element>
  <xs:element name="winKey">
    <xs:complexType><xs:sequence><xs:element name="s" type="S" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
    <xs:key name="axisKey"><xs:selector xpath="s"/><xs:field xpath="attribute::x"/></xs:key>
  </xs:element>
  <xs:element name="root">
    <xs:complexType><xs:sequence><xs:element ref="win"/></xs:sequence></xs:complexType>
  </xs:element>
</xs:schema>
