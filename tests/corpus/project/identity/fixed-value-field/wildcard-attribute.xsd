<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:attribute name="a" type="xs:string"/>
  <xs:attribute name="b" type="xs:int" fixed="1"/>
  <xs:element name="p"><xs:complexType><xs:sequence>
    <xs:element name="c" maxOccurs="unbounded"><xs:complexType><xs:anyAttribute processContents="strict"/></xs:complexType></xs:element>
  </xs:sequence></xs:complexType>
  <xs:unique name="u"><xs:selector xpath="c"/><xs:field xpath="@a|@b"/></xs:unique>
  </xs:element>
</xs:schema>
