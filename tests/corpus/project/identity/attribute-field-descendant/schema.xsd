<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="N">
    <xs:sequence><xs:element name="a" type="N" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="x" type="xs:string"/>
  </xs:complexType>
  <xs:element name="root">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="s" type="N"/>
        <xs:element name="t" type="N"/>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="anyDepthX"><xs:selector xpath="s"/><xs:field xpath=".//@x"/></xs:unique>
    <xs:unique name="belowX"><xs:selector xpath="t"/><xs:field xpath=".//a/@x"/></xs:unique>
  </xs:element>
</xs:schema>
