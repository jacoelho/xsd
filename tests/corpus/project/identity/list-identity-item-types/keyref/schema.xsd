<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="StringList"><xs:list itemType="xs:string"/></xs:simpleType>
  <xs:simpleType name="OtherStringList"><xs:list itemType="xs:string"/></xs:simpleType>
  <xs:simpleType name="IntList"><xs:list itemType="xs:int"/></xs:simpleType>
  <xs:simpleType name="IntegerList"><xs:list itemType="xs:integer"/></xs:simpleType>
  <xs:element name="root">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="ks"><xs:complexType><xs:attribute name="v" type="StringList" use="required"/></xs:complexType></xs:element>
        <xs:element name="ki"><xs:complexType><xs:attribute name="v" type="IntList" use="required"/></xs:complexType></xs:element>
        <xs:element name="rs"><xs:complexType><xs:attribute name="ref" type="StringList" use="required"/></xs:complexType></xs:element>
        <xs:element name="ro"><xs:complexType><xs:attribute name="ref" type="OtherStringList" use="required"/></xs:complexType></xs:element>
        <xs:element name="ri"><xs:complexType><xs:attribute name="ref" type="IntList" use="required"/></xs:complexType></xs:element>
        <xs:element name="rg"><xs:complexType><xs:attribute name="ref" type="IntegerList" use="required"/></xs:complexType></xs:element>
        <xs:element name="rstr"><xs:complexType><xs:attribute name="ref" type="xs:string" use="required"/></xs:complexType></xs:element>
        <xs:element name="rint"><xs:complexType><xs:attribute name="ref" type="xs:int" use="required"/></xs:complexType></xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:key name="keys"><xs:selector xpath="ks|ki"/><xs:field xpath="@v"/></xs:key>
    <xs:keyref name="refs" refer="keys"><xs:selector xpath="rs|ro|ri|rg|rstr|rint"/><xs:field xpath="@ref"/></xs:keyref>
  </xs:element>
</xs:schema>
