<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:group name="G">
    <xs:sequence>
      <xs:element name="list">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="k" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
        <xs:key name="unique-k">
          <xs:selector xpath="k"/>
          <xs:field xpath="."/>
        </xs:key>
      </xs:element>
    </xs:sequence>
  </xs:group>
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="gone" minOccurs="0" maxOccurs="0">
          <xs:complexType>
            <xs:group ref="G"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="live">
          <xs:complexType>
            <xs:group ref="G"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
